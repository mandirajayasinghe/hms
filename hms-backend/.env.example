PORT=5000
NODE_ENV=development

# PostgreSQL (local instance, matches spec: MySQL/PostgreSQL/SQL Server/Oracle)
PGHOST=localhost
PGPORT=5432
PGDATABASE=hms_db
PGUSER=hms_user
PGPASSWORD=hms_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_too_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# CORS
CLIENT_ORIGIN=http://localhost:5173